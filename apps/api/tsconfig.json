{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "useDefineForClassFields": false,
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": true,
    "declaration": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.mts"]
}
