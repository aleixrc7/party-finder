# Copy to the repo root as `.env`:  cp infra/.env.example .env
# Development values only. Never commit a real .env.

# --- PostgreSQL ---
POSTGRES_USER=party
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=party_finder
POSTGRES_PORT=5432
DATABASE_URL=postgresql://party:change-me-postgres@localhost:5432/party_finder?schema=public

# --- Redis (sessions, rate limiting) ---
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
REDIS_URL=redis://:change-me-redis@localhost:6379

# --- Object storage (MinIO locally, S3 or R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=party-finder-images
S3_ACCESS_KEY=party-minio
S3_SECRET_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true
# Public base URL for uploaded objects; image URLs returned by the API start with it.
S3_PUBLIC_URL=http://localhost:9000/party-finder-images
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- API ---
API_PORT=3000
# Origin of the web app, for CORS and cookie checks.
WEB_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Cloudflare Turnstile. These are Cloudflare's public *testing* keys (always pass).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Web ---
VITE_API_URL=/api
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- Seed ---
SEED_USER_PASSWORD=party-finder-dev
