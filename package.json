{
  "name": "party-finder",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "pnpm --filter @party-finder/shared build && prisma generate",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p tsconfig.json --noEmit",
    "test": "pnpm -r --if-present run test",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "openapi:lint": "redocly lint docs/openapi.yaml"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "~6.19.0",
    "@redocly/cli": "^1.34.5",
    "@types/node": "^22.10.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "prisma": "~6.19.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
